# --- LiveKit Cloud project (livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- SIP outbound trunk ---
# Created via `lk sip outbound create sip/trunk.json` once your Twilio Elastic
# SIP Trunk exists. See README.md "Telephony setup" for the exact steps.
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx

# Fixed test line this bot must call. Do not change for submission calls.
TEST_LINE_NUMBER=+18054398008

# --- STT: Deepgram ---
DEEPGRAM_API_KEY=

# --- LLM + RAG embeddings: OpenAI ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- TTS: Cartesia ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Call behavior ---
MAX_CALL_SECONDS=240
AUDIO_OUTPUT_FORMAT=ogg
